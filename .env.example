# ── Supabase ─────────────────────────────────────────────────────────
# Project URL and publishable (anon) key from
# Supabase Dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# ── App ──────────────────────────────────────────────────────────────
# Public URL of the deployed app (no trailing slash). Used to build the
# OAuth redirect. On Vercel this can be left blank; the app falls back to
# VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL automatically.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Only accounts on this Google Workspace domain may sign in. The database
# enforces the same rule (see supabase/migrations/0001_init.sql).
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAIN=clay.com

# ── Slack (optional) ─────────────────────────────────────────────────
# Bot token (xoxb-…) of a Slack app installed in the workspace, with the
# `users:read` and `users:read.email` scopes. When set, each person's Slack
# photo becomes their avatar (looked up by email on sign-in and weekly).
# Leave blank to use initials avatars.
SLACK_BOT_TOKEN=

# ── Slack assistant (optional) ────────────────────────────────────────
# Signing secret from the Slack app's Basic Information page. Enables the
# Events API endpoint (/api/slack/events) that answers @mentions and DMs.
SLACK_SIGNING_SECRET=
# Vercel AI Gateway key (AI Gateway → API keys). On Vercel you can leave this
# blank and rely on the project's OIDC identity instead.
AI_GATEWAY_API_KEY=
# Model id on the gateway; defaults to anthropic/claude-sonnet-5.
SLACK_AGENT_MODEL=

# ── Service role (server only) ───────────────────────────────────────
# Used by the weekly digest cron and the Claude connector (/api/mcp), which
# re-apply visibility rules themselves. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ── Feature flags (optional) ──────────────────────────────────────────
# On Vercel, the booleans WORKFLOWS_BETA, ENABLEMENT_APPROVED, MCP_CONNECTOR and AI_SEARCH in Vercel
# Flags decide, targeted per user (entity `user` with id and email). Nobody
# is on by default, admins included: add yourself to a flag's rules to opt in.
# The app reads them with the project's OIDC token, or a FLAGS SDK key if set.
# WORKFLOWS_FLAG_KEY / ENABLEMENT_FLAG_KEY / CONNECTOR_FLAG_KEY override the keys. With
# FLAGS_SECRET set, the Vercel Toolbar can override a flag for your browser.
#
# The env vars below are the fallback off Vercel (local development) and if
# Vercel Flags can't be reached: true (everyone signed in), false/blank (no
# one), or comma-separated emails (a@clay.com), domains (@clay.com) or *.
WORKFLOWS_BETA=
ENABLEMENT_APPROVED=
# The connector (MCP): /connect, connecting an app, and every /api/mcp request.
MCP_CONNECTOR=
# Ask AI on Discover (natural-language search with reasons and follow-ups).
AI_SEARCH=
# Optional: AI Gateway model id for Ask AI; defaults to SLACK_AGENT_MODEL's default.
AI_SEARCH_MODEL=
# Self-hosted open-weight model instead of the AI Gateway (Ask AI and the Slack
# assistant): any OpenAI-compatible server, e.g. infra/modal/llm.py (vLLM on
# Modal). When LLM_BASE_URL is set, the *_MODEL ids above are ignored.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Optional: request timeout in ms (default 150000 self-hosted, for cold starts; 30000 on the Gateway).
LLM_TIMEOUT_MS=
# Slack channel id (C0123…) that hears about new Enablement review requests.
ENABLEMENT_SLACK_CHANNEL=
